generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum FirstType {
  global
  european
}

model Study {
  id                                Int                       @id @default(autoincrement())
  cpmsId                            Int                       @unique
  recordStatus                      String
  route                             String
  irasId                            String?
  protocolReferenceNumber           String?
  sampleSize                        Int?
  chiefInvestigatorFirstName        String?
  chiefInvestigatorLastName         String?
  managingSpeciality                String
  plannedOpeningDate                DateTime?
  plannedClosureDate                DateTime?
  actualOpeningDate                 DateTime?
  actualClosureDate                 DateTime?
  createdAt                         DateTime                  @default(now())
  updatedAt                         DateTime                  @updatedAt
  isDeleted                         Boolean?                  @default(false)
  shortTitle                        String
  studyStatus                       String
  title                             String                    @db.Text
  totalRecruitmentToDate            Int?
  lastAssessmentId                  Int?                      @unique
  estimatedReopeningDate            DateTime?
  dueAssessmentAt                   DateTime?
  leadAdministrationId              Int?
  willRecruitWithinTimeline         Boolean                   @default(true)
  reasonNotRecruitingWithinTimeline String?                   @db.Text
  hraApprovalDate                   DateTime?
  assessments                       Assessment[]
  lastAssessment                    Assessment?               @relation("StudyLastAssessment", fields: [lastAssessmentId], references: [id])
  evaluationCategories              StudyEvaluationCategory[]
  funders                           StudyFunder[]
  organisations                     StudyOrganisation[]
  StudyUpdates                      StudyUpdates[]
  StudyFirst                        StudyFirst?

  @@index([cpmsId])
}

model Organisation {
  id            Int                 @id @default(autoincrement())
  name          String
  rtsIdentifier String              @unique
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  isDeleted     Boolean?            @default(false)
  roles         OrganisationRole[]
  fundedStudies StudyFunder[]
  studies       StudyOrganisation[]
  users         UserOrganisation[]

  @@index([rtsIdentifier])
}

model OrganisationRole {
  id             Int                    @id @default(autoincrement())
  organisationId Int
  roleId         Int
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  isDeleted      Boolean?               @default(false)
  organisation   Organisation           @relation(fields: [organisationId], references: [id])
  role           SysRefOrganisationRole @relation(fields: [roleId], references: [id])

  @@unique([organisationId, roleId])
  @@index([roleId], map: "OrganisationRole_roleId_fkey")
}

model User {
  id                          Int                          @id @default(autoincrement())
  identityGatewayId           String?
  registrationToken           String?
  registrationConfirmed       Boolean?                     @default(false)
  isDeleted                   Boolean?                     @default(false)
  email                       String                       @unique
  name                        String?
  lastLogin                   DateTime?
  assessments                 Assessment[]
  assessmentReminders         AssessmentReminder[]
  createdStudyUpdates         StudyUpdates[]               @relation("createdStudyUpdates")
  modifiedStudyUpdates        StudyUpdates[]               @relation("modifiedStudyUpdates")
  createdOrganisations        UserOrganisation[]           @relation("createdOrganisations")
  updatedOrganisations        UserOrganisation[]           @relation("updatedOrganisations")
  organisations               UserOrganisation[]           @relation("userOrganisation")
  organisationInvitationsSent UserOrganisationInvitation[] @relation("userOrganisationInvitationsSent")
  createdRoles                UserRole[]                   @relation("createdRoles")
  updatedRoles                UserRole[]                   @relation("updatedRoles")
  roles                       UserRole[]                   @relation("userRoles")
  createdStudyFirsts          StudyFirst[]                 @relation("StudyFirstCreatedBy")
  modifiedStudyFirsts         StudyFirst[]                 @relation("StudyFirstModifiedBy")
}

model UserRole {
  id          Int        @id @default(autoincrement())
  userId      Int
  roleId      Int
  createdById Int
  updatedById Int
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  isDeleted   Boolean?   @default(false)
  createdBy   User       @relation("createdRoles", fields: [createdById], references: [id])
  role        SysRefRole @relation(fields: [roleId], references: [id])
  updatedBy   User       @relation("updatedRoles", fields: [updatedById], references: [id])
  user        User       @relation("userRoles", fields: [userId], references: [id])

  @@unique([userId, roleId])
  @@index([createdById], map: "UserRole_createdById_fkey")
  @@index([roleId], map: "UserRole_roleId_fkey")
  @@index([updatedById], map: "UserRole_updatedById_fkey")
}

model UserOrganisation {
  id             Int                          @id @default(autoincrement())
  userId         Int
  organisationId Int
  createdById    Int
  updatedById    Int
  createdAt      DateTime                     @default(now())
  updatedAt      DateTime                     @updatedAt
  isDeleted      Boolean?                     @default(false)
  createdBy      User                         @relation("createdOrganisations", fields: [createdById], references: [id])
  organisation   Organisation                 @relation(fields: [organisationId], references: [id])
  updatedBy      User                         @relation("updatedOrganisations", fields: [updatedById], references: [id])
  user           User                         @relation("userOrganisation", fields: [userId], references: [id])
  invitations    UserOrganisationInvitation[] @relation("userOrganisationInvitations")

  @@unique([userId, organisationId])
  @@index([createdById], map: "UserOrganisation_createdById_fkey")
  @@index([organisationId], map: "UserOrganisation_organisationId_fkey")
  @@index([updatedById], map: "UserOrganisation_updatedById_fkey")
}

model UserOrganisationInvitation {
  id                 Int                    @id @default(autoincrement())
  userOrganisationId Int
  messageId          String
  timestamp          DateTime
  statusId           Int
  failureNotifiedAt  DateTime?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  isDeleted          Boolean?               @default(false)
  sentById           Int
  sentBy             User                   @relation("userOrganisationInvitationsSent", fields: [sentById], references: [id])
  status             SysRefInvitationStatus @relation(fields: [statusId], references: [id])
  userOrganisation   UserOrganisation       @relation("userOrganisationInvitations", fields: [userOrganisationId], references: [id])

  @@index([sentById], map: "UserOrganisationInvitation_sentById_fkey")
  @@index([statusId], map: "UserOrganisationInvitation_statusId_fkey")
  @@index([userOrganisationId], map: "UserOrganisationInvitation_userOrganisationId_fkey")
}

model StudyOrganisation {
  id                 Int                    @id @default(autoincrement())
  studyId            Int
  organisationId     Int
  organisationRoleId Int
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  isDeleted          Boolean?               @default(false)
  organisation       Organisation           @relation(fields: [organisationId], references: [id])
  organisationRole   SysRefOrganisationRole @relation(fields: [organisationRoleId], references: [id])
  study              Study                  @relation(fields: [studyId], references: [id])

  @@unique([studyId, organisationId])
  @@index([organisationId], map: "StudyOrganisation_organisationId_fkey")
  @@index([organisationRoleId], map: "StudyOrganisation_organisationRoleId_fkey")
}

model StudyEvaluationCategory {
  id                     Int       @id @default(autoincrement())
  studyId                Int
  indicatorType          String
  indicatorValue         String
  sampleSize             Int?
  totalRecruitmentToDate Int
  plannedOpeningDate     DateTime?
  plannedClosureDate     DateTime?
  actualOpeningDate      DateTime?
  actualClosureDate      DateTime?
  expectedReopenDate     DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  isDeleted              Boolean?  @default(false)
  study                  Study     @relation(fields: [studyId], references: [id])

  @@unique([studyId, indicatorValue])
}

model StudyFunder {
  id                Int          @id @default(autoincrement())
  studyId           Int
  organisationId    Int
  grantCode         String
  fundingStreamName String
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  isDeleted         Boolean?     @default(false)
  organisation      Organisation @relation(fields: [organisationId], references: [id])
  study             Study        @relation(fields: [studyId], references: [id])

  @@unique([studyId, organisationId])
  @@index([organisationId], map: "StudyFunder_organisationId_fkey")
}

model Assessment {
  id                      Int                            @id @default(autoincrement())
  studyId                 Int
  statusId                Int
  createdById             Int
  createdAt               DateTime                       @default(now())
  updatedAt               DateTime                       @updatedAt
  isDeleted               Boolean?                       @default(false)
  reasonForNoRecruitment  String?                        @db.Text
  createdBy               User                           @relation(fields: [createdById], references: [id])
  status                  SysRefAssessmentStatus         @relation(fields: [statusId], references: [id])
  study                   Study                          @relation(fields: [studyId], references: [id])
  furtherInformation      AssessmentFurtherInformation[]
  lastAssessmentFor       Study?                         @relation("StudyLastAssessment")

  @@index([createdById], map: "Assessment_createdById_fkey")
  @@index([statusId], map: "Assessment_statusId_fkey")
  @@index([studyId], map: "Assessment_studyId_fkey")
}

model AssessmentFurtherInformation {
  id                     Int                                 @id @default(autoincrement())
  assessmentId           Int
  furtherInformationId   Int?
  furtherInformationText String?                             @db.Text
  isDeleted              Boolean?                            @default(false)
  assessment             Assessment                          @relation(fields: [assessmentId], references: [id])
  furtherInformation     SysRefAssessmentFurtherInformation? @relation(fields: [furtherInformationId], references: [id])

  @@index([assessmentId], map: "AssessmentFurtherInformation_assessmentId_fkey")
  @@index([furtherInformationId], map: "AssessmentFurtherInformation_furtherInformationId_fkey")
}

model AssessmentReminder {
  id        Int       @id @default(autoincrement())
  userId    Int
  sentAt    DateTime?
  createdAt DateTime  @default(now())
  messageId String?
  user      User      @relation(fields: [userId], references: [id])

  @@index([userId], map: "AssessmentReminder_userId_fkey")
}

model StudyUpdates {
  id                              Int                    @id @default(autoincrement())
  studyId                         Int
  studyStatus                     String?
  plannedOpeningDate              DateTime?
  actualOpeningDate               DateTime?
  plannedClosureToRecruitmentDate DateTime?
  actualClosureToRecruitmentDate  DateTime?
  estimatedReopeningDate          DateTime?
  ukRecruitmentTarget             Int?
  studyUpdateTypeId               Int
  comment                         String?                @db.VarChar(500)
  isDeleted                       Boolean?               @default(false)
  LSN                             Bytes?                 @db.Binary(10)
  createdAt                       DateTime               @default(now())
  createdById                     Int
  modifiedAt                      DateTime               @updatedAt
  modifiedById                    Int
  studyStatusGroup                String
  studyUpdateStateId              Int
  transactionId                   String
  createdBy                       User                   @relation("createdStudyUpdates", fields: [createdById], references: [id])
  modifiedBy                      User                   @relation("modifiedStudyUpdates", fields: [modifiedById], references: [id])
  study                           Study                  @relation(fields: [studyId], references: [id])
  studyUpdateState                SysRefStudyUpdateState @relation(fields: [studyUpdateStateId], references: [id])
  studyUpdateType                 SysRefStudyUpdateType  @relation(fields: [studyUpdateTypeId], references: [id])

  @@index([createdById], map: "StudyUpdates_createdById_fkey")
  @@index([modifiedById], map: "StudyUpdates_modifiedById_fkey")
  @@index([studyId], map: "StudyUpdates_studyId_fkey")
  @@index([studyUpdateStateId], map: "StudyUpdates_studyUpdateStateId_fkey")
  @@index([studyUpdateTypeId], map: "StudyUpdates_studyUpdateTypeId_fkey")
}

model SysRefStudyUpdateState {
  id           Int            @id @default(autoincrement())
  state        String
  description  String         @db.Text
  StudyUpdates StudyUpdates[]
}

model SysRefStudyUpdateType {
  id           Int            @id @default(autoincrement())
  name         String
  description  String         @db.Text
  StudyUpdates StudyUpdates[]
}

model SysRefRole {
  id          Int        @id @default(autoincrement())
  name        String
  description String     @db.Text
  isDeleted   Boolean    @default(false)
  users       UserRole[]
}

model SysRefAssessmentStatus {
  id          Int          @id @default(autoincrement())
  name        String
  description String       @db.Text
  isDeleted   Boolean      @default(false)
  assessments Assessment[]
}

model SysRefAssessmentFurtherInformation {
  id          Int                            @id @default(autoincrement())
  name        String
  description String                         @db.Text
  sortOrder   Int
  isDeleted   Boolean                        @default(false)
  assessments AssessmentFurtherInformation[]
}

model SysRefOrganisationRole {
  id            Int                 @id @default(autoincrement())
  name          String
  description   String              @db.Text
  rtsIdentifier String              @unique
  isDeleted     Boolean             @default(false)
  organisations OrganisationRole[]
  studies       StudyOrganisation[]

  @@index([rtsIdentifier])
}

model SysRefInvitationStatus {
  id                         Int                          @id @default(autoincrement())
  name                       String
  userOrganisationInvitation UserOrganisationInvitation[]
}

model StudyFirst {
  id           Int       @id @default(autoincrement())
  studyId      Int       @unique
  type         FirstType
  firstAt      DateTime
  siteName     String    @db.Text
  piTitle      String?
  piFullName   String
  piEmail      String
  createdById  Int
  modifiedById Int?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  createdBy    User      @relation("StudyFirstCreatedBy", fields: [createdById], references: [id])
  modifiedBy   User?     @relation("StudyFirstModifiedBy", fields: [modifiedById], references: [id])
  study        Study     @relation(fields: [studyId], references: [id])

  @@index([createdById], map: "StudyFirst_createdById_fkey")
  @@index([modifiedById], map: "StudyFirst_modifiedById_fkey")
  @@index([studyId], map: "StudyFirst_studyId_fkey")
}
